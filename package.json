{
    "name": "debugging-cdp-targets",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": "24.21.0"
    },
    "packageManager": "pnpm@12.4.2",
    "scripts": {
        "prepare": "husky",
        "format": "pnpm format:write",
        "format:write": "biome check --write --files-ignore-unknown=true .",
        "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false --files-ignore-unknown=true .",
        "lint": "biome check --formatter-enabled=false --files-ignore-unknown=true .",
        "check:scripts": "node tooling/check-scripts.mjs",
        "test": "node --test tests/*.test.mjs",
        "test:coverage": "node --experimental-test-coverage --test-coverage-lines=52 --test-coverage-branches=71 --test-coverage-functions=61 --test tests/*.test.mjs",
        "check:repo": "node tooling/repository-audit.mjs",
        "check:distribution": "node tooling/distribution-audit.mjs",
        "build:plugin": "node tooling/build-plugin.mjs",
        "check:build": "node tooling/build-plugin.mjs --check",
        "check:commits": "node tooling/check-commits.mjs",
        "check:security": "node tooling/check-security.mjs --root .",
        "build:security": "node tooling/build-security.mjs",
        "check:security:build": "node tooling/build-security.mjs --check",
        "verify:push": "pnpm format:check && pnpm lint && pnpm check:scripts && pnpm test:coverage && pnpm check:repo && pnpm check:build && pnpm check:security:build && pnpm check:distribution && pnpm check:commits"
    },
    "lint-staged": {
        "*.{js,cjs,mjs,json}": "biome check --write --no-errors-on-unmatched",
        "*.{md,yaml,yml,ps1,psd1,psm1,toml,sh}": "node tooling/check-text-style.mjs"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@commitlint/cli": "21.2.2",
        "@commitlint/config-conventional": "21.2.2",
        "acorn": "8.18.0",
        "esbuild": "0.28.2",
        "husky": "9.1.7",
        "lint-staged": "17.5.1",
        "ws": "8.22.0",
        "yaml": "2.9.1"
    }
}
